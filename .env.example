# Copy to an untracked .env for local development. Never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
CIRVANNA_SERVICE_NAME=cirvanna
CIRVANNA_API_BASE_URL=http://localhost:8000

# Supply local-only credentials in secret storage.
DATABASE_URL=
REDIS_URL=
MESSAGE_BROKER_URL=
VECTOR_STORE_URL=
GRAPH_DATABASE_URL=
INTERNAL_API_KEY=
ADMIN_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Observability
METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ML assets; paths are local and must not be committed.
SMPL_MODEL_PATH=
DEEPLAB_WEIGHTS_PATH=
MOVENET_WEIGHTS_PATH=

# Production Commerce authentication must use the identity provider's RS256/JWKS configuration.
# Local development only; deployed production environments should set COMMERCE_ENVIRONMENT=production
# and COMMERCE_AUTH_MODE=oidc_jwks, then configure JWKS_URL, ISSUER, AUDIENCE, and role claim.
COMMERCE_ENVIRONMENT=development
COMMERCE_AUTH_MODE=hs256
COMMERCE_JWT_JWKS_URL=
COMMERCE_JWT_ROLE_CLAIM=role

# Catalog service tokens: local single-token compatibility only.
CATALOG_ENVIRONMENT=development
CATALOG_READ_TOKEN=
CATALOG_WRITE_TOKEN=
