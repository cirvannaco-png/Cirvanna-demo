# Copy to an untracked .env for local development. Never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
# API Gateway must set this to production; CIL CAL feedback-review vetoes then become mandatory.
CIRVANNA_ENVIRONMENT=development
CIRVANNA_SERVICE_NAME=cirvanna
CIRVANNA_API_BASE_URL=http://localhost:8000

# Supply local-only credentials in secret storage.
DATABASE_URL=
REDIS_URL=
MESSAGE_BROKER_URL=
VECTOR_STORE_URL=
GRAPH_DATABASE_URL=
INTERNAL_API_KEY=
ADMIN_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Observability — set unique per-service metrics tokens in the secret manager.
# The scrape route is private and disabled unless METRICS_ENABLED=true.
METRICS_ENABLED=false
OBSERVABILITY_METRICS_TOKEN=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=

# ML assets; paths are local and must not be committed.
SMPL_MODEL_PATH=
DEEPLAB_WEIGHTS_PATH=
MOVENET_WEIGHTS_PATH=

# Commerce authentication. HS256 is for local development/tests only.
# Production MUST use provider-issued RS256 access tokens and oidc_jwks mode.
COMMERCE_ENVIRONMENT=development
# Keep Shopify inventory reservations staging-only until live provider and operational acceptance.
SHOPIFY_INVENTORY_RESERVATION_PRODUCTION_ENABLED=false
# Optional OAuth scope for irreversible Shopify order cancellation; staff must also have cancel_orders permission.
SHOPIFY_COMPENSATION_SCOPE_ENABLED=false
# In non-production test/staging harnesses, explicitly enable provider checks without
# forcing the API authentication mode to production OIDC.
COMMERCE_MARKET_PROVIDER_VERIFICATION_REQUIRED=false
COMMERCE_AUTH_MODE=hs256
COMMERCE_DATABASE_URL=
COMMERCE_AUTO_CREATE_SCHEMA=false
COMMERCE_JWT_SECRET=
COMMERCE_JWT_JWKS_URL=
COMMERCE_JWT_ISSUER=
COMMERCE_JWT_AUDIENCE=
COMMERCE_JWT_ROLE_CLAIM=role
COMMERCE_CORS_ORIGINS=

# Catalog must use a separate managed database in deployed environments.
CATALOG_ENVIRONMENT=development
CATALOG_DATABASE_URL=
CATALOG_AUTO_CREATE_SCHEMA=false
CATALOG_READ_TOKEN=
CATALOG_WRITE_TOKEN=
CATALOG_API_URL=
CATALOG_API_TOKEN=

# Marketplace BFF upstreams; configure HTTPS URLs in deployed environments.
COMMERCE_API_URL=
# Dedicated Decision Gateway -> Commerce raw offer/compare read credential (32+ bytes).
COMMERCE_MARKETPLACE_READ_TOKEN=
# Explicit kill switch. Keep disabled until staging purchase authorization is verified.
COMMERCE_CAL_PURCHASE_PROXY_ENABLED=false
MARKETPLACE_HTML_PATH=
MARKETPLACE_ENVIRONMENT=development
MARKETPLACE_ENABLE_DEVELOPER_TOKEN_INPUT=false

# Internal CAL purchase authorization. The same dedicated HMAC key must be
# provisioned only to Commerce and the Decision Gateway; never to the browser.
DECISION_GATEWAY_URL=
DECISION_GATEWAY_TOKEN=
CAL_PURCHASE_RECEIPT_HMAC_SECRET=

# Production/staging market-provider verification adapters. These are trusted
# Cirvanna adapter service URLs, not direct user-supplied provider endpoints.
# The adapter verifies real provider credentials/results and returns resource-bound
# evidence SHA-256 + exact quote/capability data. Set via the secret manager.
MERCHANT_VERIFICATION_ADAPTER_URL=
MERCHANT_VERIFICATION_ADAPTER_TOKEN=
FULFILLMENT_ADAPTER_URL=
FULFILLMENT_ADAPTER_TOKEN=
FX_ADAPTER_URL=
FX_ADAPTER_TOKEN=
TAX_ADAPTER_URL=
TAX_ADAPTER_TOKEN=
PAYMENT_CAPABILITY_ADAPTER_URL=
PAYMENT_CAPABILITY_ADAPTER_TOKEN=

# Stripe Checkout and webhook. Use test-mode keys in staging, stored only
# in the provider's secret manager. Never put these values in frontend code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_CHECKOUT_SUCCESS_URL=
COMMERCE_CHECKOUT_CANCEL_URL=
COMMERCE_SHIPPING_COUNTRIES=
COMMERCE_CRON_TOKEN=

# Operational settings to configure before launch.
# Scrape /internal/metrics privately using X-Observability-Token. Never expose this token to a browser.
# Schedule POST /internal/expire-reservations with X-Commerce-Cron-Token.
# Configure monitoring, alert routing, backup/restore, retention and rollback
# separately; empty values here are documentation placeholders, not live config.

# USI and TAL persistence. Point IDENTITY_DATABASE_URL at the existing
# approved managed Postgres instance; do not create a duplicate database.
IDENTITY_DATABASE_URL=
IDENTITY_AUTO_CREATE_SCHEMA=false
IDENTITY_SERVICE_URL=
IDENTITY_SERVICE_TOKEN=
IDENTITY_CRON_TOKEN=
CIRVANNA_REQUIRE_VERIFIED_IDENTITY=true
CIRVANNA_AUDIT_DB=./.cirvanna/audit.sqlite3

# Independent decision evidence providers. These values must be provisioned
# from independently validated providers and a distinct evaluator; never invent
# report hashes or share the provider evidence key with the evaluator key.
SAFETY_SERVICE_URL=
SAFETY_SERVICE_TOKEN=
SAFETY_EVIDENCE_HMAC_SECRET=
SAFETY_VALIDATION_HMAC_SECRET=
SAFETY_VALIDATION_REPORT_SHA256=
FCI_SERVICE_URL=
FCI_SERVICE_TOKEN=
FCI_EVIDENCE_HMAC_SECRET=
FCI_VALIDATION_HMAC_SECRET=
FCI_VALIDATION_REPORT_SHA256=

# Age assurance — Yoti AVS Digital ID only; no age-estimation or document-scan fallback.
# Server-authoritative EEPL rules; JSON object keyed by policy_id. Never accept thresholds from clients.
EEPL_POLICY_ID=
EEPL_POLICY_REGISTRY_JSON=
# Use a separate Yoti API key and SDK ID; all values belong in the provider secret manager.
YOTI_AVS_API_KEY=
YOTI_AVS_SDK_ID=
YOTI_AVS_CALLBACK_URL=
YOTI_AVS_CANCEL_URL=
YOTI_AVS_PRIVACY_POLICY_URL=
YOTI_AVS_TERMS_URL=
# Dedicated HMAC key shared only by the age-evidence issuer and Decision Service.
AGE_EVIDENCE_HMAC_SECRET=
AGE_EVIDENCE_REDEMPTION_URL=
AGE_EVIDENCE_REDEMPTION_TOKEN=
AGE_EVIDENCE_ORCHESTRATOR_TOKEN=

## Cirvanna Intelligence Layer (CIL) — use PostgreSQL outside local tests
CIL_ENVIRONMENT=development
CIL_DATABASE_URL=
CIL_AUTO_CREATE_SCHEMA=false
CIL_ADMIN_TOKEN=
CIL_SERVICE_TOKEN=
CIL_CATALOG_SERVICE_TOKEN=
CIL_CAL_SERVICE_TOKEN=
# Enable in every deployed customer-serving environment; the CIL review store must be healthy.
CIL_CAL_REVIEW_ENFORCEMENT_REQUIRED=false
CAL_REVIEW_OPERATOR_TOKEN=
CIL_CONSENT_RECEIPT_KEY=
CIL_CAL_RECEIPT_KEY=
CIL_SKIN_ANALYSIS_CONSENT_KEY=
CIL_UNSUITABLE_SHARE_REVIEW_THRESHOLD=0.25
CIL_FEEDBACK_RANKING_WEIGHT=0.10
# Enable only after the CIL review store, Gateway and Decision Service are deployed and staging-tested.
CIL_GATEWAY_URL=
CIL_SERVICE_URL=
# Generic licensed research provider adapter; no vendor is enabled by default
CIL_PROVIDER_BASE_URL=
CIL_PROVIDER_API_TOKEN=
CIL_PROVIDER_LICENCE_ID=
CIL_PROVIDER_TERMS_URL=

# Perfect Corp YouCam AI Skin Analysis (disabled until DPA and retention review)
CIL_PERFECTCORP_ENABLED=false
CIL_PERFECTCORP_DPA_APPROVED=false
CIL_PERFECTCORP_RETENTION_POLICY_REF=
CIL_PERFECTCORP_ERASURE_SLA_CONFIRMED=false
CIL_PERFECTCORP_MAX_RETENTION_HOURS=720
CIL_PERFECTCORP_API_TOKEN=
CIL_PERFECTCORP_API_BASE_URL=https://yce-api-01.makeupar.com
CIL_PERFECTCORP_LICENCE_ID=
CIL_PERFECTCORP_TERMS_URL=
CIL_PERFECTCORP_TASK_TTL_MINUTES=30

# Canonical CIL provider consent and revocation configuration.
# Separate token held only by the verified adult-eligibility assertion service for CIL receipt issuance.
IDENTITY_CIL_CONSENT_ISSUER_TOKEN=
# CIL-only credential for live canonical skin-analysis consent checks.
IDENTITY_CIL_CONSENT_VERIFIER_TOKEN=
# Identity Learning only: HMAC key for stable, non-reversible CIL contributor pseudonyms.
CIL_CONTRIBUTOR_TOKEN_HMAC_SECRET=
# Identity Learning issues short-lived digest-bound provider receipts (60-900 seconds).
CIL_SKIN_ANALYSIS_RECEIPT_TTL_SECONDS=600

# Shopify compensation and catalogue sync operations settings.
# Shopify saga and manual-review operations settings forward-ported with the commerce integration.
# Optional signed operator webhook for durable Commerce manual-review events.
# Required before compensation/refund manual-review events can be acknowledged by Sync.
COMMERCE_OPERATIONS_WEBHOOK_URL=
COMMERCE_OPERATIONS_WEBHOOK_SECRET=

# Shared PostgreSQL append-only CaTaCaCi decision receipt store (separate least-privileged login)
DECISION_AUDIT_DATABASE_URL=

# CaTaCaCi governance: separate service credentials and server-owned privacy configuration
CATACACI_CAM_SERVICE_TOKEN=
CATACACI_CIL_SERVICE_TOKEN=
CATACACI_CIL_AGGREGATE_TOKEN=
CATACACI_CIL_ALLOWED_COHORT_KEYS=
CATACACI_CIL_RELEASE_EPSILON=0.5
CATACACI_CIL_EPSILON_BUDGET=1.0
CATACACI_VSL_PROPOSER_TOKEN=
CATACACI_VSL_APPROVER_TOKEN=
CATACACI_VSL_PROPOSER_ID=
CATACACI_VSL_APPROVER_ID=
