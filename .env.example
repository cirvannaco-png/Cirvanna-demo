# Copy to an untracked .env for local development. Never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
CIRVANNA_SERVICE_NAME=cirvanna
CIRVANNA_API_BASE_URL=http://localhost:8000

# Supply local-only credentials in secret storage.
DATABASE_URL=
REDIS_URL=
MESSAGE_BROKER_URL=
VECTOR_STORE_URL=
GRAPH_DATABASE_URL=
INTERNAL_API_KEY=
ADMIN_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Observability
METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ML assets; paths are local and must not be committed.
SMPL_MODEL_PATH=
DEEPLAB_WEIGHTS_PATH=
MOVENET_WEIGHTS_PATH=

# Commerce authentication. HS256 is for local development/tests only.
# Production MUST use provider-issued RS256 access tokens and oidc_jwks mode.
COMMERCE_ENVIRONMENT=development
COMMERCE_AUTH_MODE=hs256
COMMERCE_DATABASE_URL=
COMMERCE_AUTO_CREATE_SCHEMA=false
COMMERCE_JWT_SECRET=
COMMERCE_JWT_JWKS_URL=
COMMERCE_JWT_ISSUER=
COMMERCE_JWT_AUDIENCE=
COMMERCE_JWT_ROLE_CLAIM=role
COMMERCE_CORS_ORIGINS=

# Catalog must use a separate managed database in deployed environments.
CATALOG_ENVIRONMENT=development
CATALOG_DATABASE_URL=
CATALOG_AUTO_CREATE_SCHEMA=false
CATALOG_READ_TOKEN=
CATALOG_WRITE_TOKEN=
CATALOG_API_URL=
CATALOG_API_TOKEN=

# Marketplace BFF upstreams; configure HTTPS URLs in deployed environments.
COMMERCE_API_URL=
COMMERCE_CAL_PURCHASE_PROXY_ENABLED=false
MARKETPLACE_HTML_PATH=
MARKETPLACE_ENVIRONMENT=development
MARKETPLACE_ENABLE_DEVELOPER_TOKEN_INPUT=false

# Internal CAL purchase authorization. The same dedicated HMAC key must be
# provisioned only to Commerce and the Decision Gateway; never to the browser.
DECISION_GATEWAY_URL=
DECISION_GATEWAY_TOKEN=
CAL_PURCHASE_RECEIPT_HMAC_SECRET=

# Stripe Checkout and webhook. Use test-mode keys in staging, stored only
# in the provider's secret manager. Never put these values in frontend code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_CHECKOUT_SUCCESS_URL=
COMMERCE_CHECKOUT_CANCEL_URL=
COMMERCE_SHIPPING_COUNTRIES=
COMMERCE_CRON_TOKEN=

# Operational settings to configure before launch.
# Schedule POST /internal/expire-reservations with X-Commerce-Cron-Token.
# Configure monitoring, alert routing, backup/restore, retention and rollback
# separately; empty values here are documentation placeholders, not live config.

# USI and TAL persistence. Point IDENTITY_DATABASE_URL at the existing
# approved managed Postgres instance; do not create a duplicate database.
IDENTITY_DATABASE_URL=
IDENTITY_AUTO_CREATE_SCHEMA=false
IDENTITY_SERVICE_URL=
IDENTITY_SERVICE_TOKEN=
IDENTITY_CRON_TOKEN=
CIRVANNA_REQUIRE_VERIFIED_IDENTITY=true
CIRVANNA_AUDIT_DB=./.cirvanna/audit.sqlite3

# Independent decision evidence providers. These values must be provisioned
# from independently validated providers and a distinct evaluator; never invent
# report hashes or share the provider evidence key with the evaluator key.
SAFETY_SERVICE_URL=
SAFETY_SERVICE_TOKEN=
SAFETY_EVIDENCE_HMAC_SECRET=
SAFETY_VALIDATION_HMAC_SECRET=
SAFETY_VALIDATION_REPORT_SHA256=
FCI_SERVICE_URL=
FCI_SERVICE_TOKEN=
FCI_EVIDENCE_HMAC_SECRET=
FCI_VALIDATION_HMAC_SECRET=
FCI_VALIDATION_REPORT_SHA256=

## Cirvanna Intelligence Layer (CIL) — use PostgreSQL outside local tests
CIL_ENVIRONMENT=development
CIL_DATABASE_URL=
CIL_AUTO_CREATE_SCHEMA=false
CIL_ADMIN_TOKEN=
CIL_SERVICE_TOKEN=
CIL_CATALOG_SERVICE_TOKEN=
CIL_CAL_SERVICE_TOKEN=
CAL_REVIEW_OPERATOR_TOKEN=
CIL_CONSENT_RECEIPT_KEY=
CIL_CAL_RECEIPT_KEY=
CIL_SKIN_ANALYSIS_CONSENT_KEY=
CIL_UNSUITABLE_SHARE_REVIEW_THRESHOLD=0.25
CIL_FEEDBACK_RANKING_WEIGHT=0.10
CIL_GATEWAY_URL=
CIL_SERVICE_URL=
# Generic licensed research provider adapter; no vendor is enabled by default
CIL_PROVIDER_BASE_URL=
CIL_PROVIDER_API_TOKEN=
CIL_PROVIDER_LICENCE_ID=
CIL_PROVIDER_TERMS_URL=

# Perfect Corp YouCam AI Skin Analysis (disabled until DPA and retention review)
CIL_PERFECTCORP_ENABLED=false
CIL_PERFECTCORP_DPA_APPROVED=false
CIL_PERFECTCORP_RETENTION_POLICY_REF=
CIL_PERFECTCORP_ERASURE_SLA_CONFIRMED=false
CIL_PERFECTCORP_MAX_RETENTION_HOURS=720
CIL_PERFECTCORP_API_TOKEN=
CIL_PERFECTCORP_API_BASE_URL=https://yce-api-01.makeupar.com
CIL_PERFECTCORP_LICENCE_ID=
CIL_PERFECTCORP_TERMS_URL=
CIL_PERFECTCORP_TASK_TTL_MINUTES=30
