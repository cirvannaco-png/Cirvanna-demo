# Generate distinct high-entropy tokens and store real values in your deployment secret manager.
VIRTUAL_TWIN_API_TOKEN=replace-with-a-long-random-user-api-secret

# Internal DermalSight endpoint. Use service DNS inside private networking where possible.
DERMALSIGHT_API_URL=http://dermalsight:8000
# Must match DERMALSIGHT_API_TOKEN configured on the DermalSight service.
DERMALSIGHT_API_TOKEN=replace-with-a-long-random-service-token
