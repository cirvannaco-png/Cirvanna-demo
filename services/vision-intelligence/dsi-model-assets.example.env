# DSI Vision worker. Use a strong secret from a secret manager; do not commit real values.
DSI_VISION_WORKER_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes

# Provision model assets through immutable deployment storage. SHA values must be
# calculated from the exact deployed file and versioned alongside the release.
DSI_FACE_LANDMARKER_MODEL_PATH=/models/dsi/face_landmarker.task
DSI_FACE_LANDMARKER_MODEL_SHA256=replace-with-64-character-sha256
DSI_FACE_LANDMARKER_MODEL_VERSION=provisioned-face-landmarker-version

DSI_SKIN_SEGMENTER_MODEL_PATH=/models/dsi/selfie_multiclass_256x256.tflite
DSI_SKIN_SEGMENTER_MODEL_SHA256=replace-with-64-character-sha256
DSI_SKIN_SEGMENTER_MODEL_VERSION=provisioned-selfie-segmenter-version
