# DSI Android capture verification — non-secret configuration template.
# Configure secrets through the deployment secret manager, never Git or Android.
DSI_ANDROID_ATTESTATION_VERIFIER_JAR_PATH=/opt/cirvanna/dsi-android-attestation-verifier.jar

# Exact Play Console Android application identity.
DSI_ANDROID_PACKAGE_NAME=<exact-production-package-name>
DSI_ANDROID_SIGNING_CERT_SHA256=<64-character-lowercase-sha256-of-play-app-signing-certificate>
DSI_ANDROID_MIN_PACKAGE_VERSION_CODE=<minimum-supported-production-version-code>

# Explicitly version every trust decision and native SDK release.
DSI_CAPTURE_VERIFIER_POLICY_VERSION=dsi-android-policy-v1
DSI_ANDROID_CAPTURE_SDK_VERSION=<immutable-sdk-release-version>

# Private Identity Learning endpoint. The dedicated DSI credential is held by
# Vision only; never by a browser or Android binary.
IDENTITY_LEARNING_API_URL=https://<private-identity-learning-host>
IDENTITY_DSI_CAPTURE_SERVICE_TOKEN=<secret-manager-reference>

# Google Play Integrity server decoding uses Application Default Credentials
# with https://www.googleapis.com/auth/playintegrity. Prefer workload identity.
# Do not commit a service-account JSON file; only use this variable when a
# managed secret mount is the approved credential source.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play-integrity.json

# Separate private service token; never reuse Identity Learning credentials.
DSI_VISION_WORKER_TOKEN=<secret-manager-reference>
