# Copy into the secret manager for the private validator deployment.
# Never commit real values or expose these settings to a browser.
TWIN_MESH_VALIDATOR_API_TOKEN=replace-with-at-least-32-random-bytes
CONSENT_API_URL=https://identity-service.internal
CONSENT_API_TOKEN=replace-with-at-least-32-random-bytes
ASSET_SERVICE_URL=https://asset-service.internal
ASSET_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
# For isolated localhost development only; never enable in deployed environments.
ALLOW_INSECURE_INTERNAL_HTTP=false
