# Use a generated secret with sufficient entropy; never commit the real token.
DERMALSIGHT_API_TOKEN=replace-with-a-long-random-secret
# Supply approved, validated model assets through secure deployment storage.
DERMALSIGHT_MODEL_PATH=/models/dermalsight.onnx
DERMALSIGHT_MODEL_MANIFEST_PATH=/models/model_manifest.json
DERMALSIGHT_VALIDATION_REPORT_PATH=/models/dermalsight-validation-report.json
# Keep this secret in a secret manager; it signs validation evidence off-line.
DERMALSIGHT_VALIDATION_SIGNING_KEY=replace-with-a-distinct-32-byte-minimum-key
